NODE_ENV=production

# ============================================
# 核心服務配置（4 組主要服務）
# ============================================

# Auth Service - 認證服務 (原 port 3001)
# 服務端環境變數（用於 next.config.mjs 的 rewrites）
AUTH_SERVICE_URL=http://localhost:3001

# Backend Service - 後端 API 服務 (原 port 8081)
# 服務端環境變數（用於 next.config.mjs 的 rewrites）
BACKEND_SERVICE_URL=http://localhost:8081

# Kibana - ELK 監控服務
NEXT_PUBLIC_KIBANA_URL=https://your-kibana-host
NEXT_PUBLIC_KIBANA_SPACE=default

# Dify - AI Workflow 服務
# 注意：Workflow API 是透過後端 proxy（後端使用 DIFY_BASE_URL）
# 以下配置僅用於 iframe 內嵌和自動登入
NEXT_PUBLIC_DIFY_URL=https://your-dify-host
NEXT_PUBLIC_DIFY_WORKFLOW_URL=https://your-dify-host/app/YOUR_APP_ID/workflow
NEXT_PUBLIC_KB_RAG_URL=https://your-dify-host/datasets
# Dify 登入憑證（伺服器端環境變數，不暴露至前端）
DIFY_EMAIL=your-dify-email@example.com
DIFY_PWD=your-dify-password

#Tenable Service - 弱掃服務
NEXT_PUBLIC_TENABLE_URL=http://localhost:8834
# ============================================
# UI 載入配置（單位：毫秒）
# ============================================
NEXT_PUBLIC_LOADING_TIMEOUT=20000
NEXT_PUBLIC_LOADING_DELAY=1500
NEXT_PUBLIC_INITIAL_LOADING_DELAY=2000
NEXT_PUBLIC_IFRAME_LOADING_DELAY=1000
NEXT_PUBLIC_IFRAME_LOADING_TIMEOUT=10000

# ============================================
# 注意：AI API Key 已移至後端 (backend/.env 的 LLM_API_KEY)
# 前端不需要配置 NEXT_PUBLIC_GEMINI_API_KEY
# ============================================

# ============================================
# Dify Chatbot API 配置（用於 Route Handlers）
# ============================================
DIFY_SERVICE_URL=https://path/to/dify
DIFY_CHAT_KEY=app-xxxxxxxxxxxxxxxx
DIFY_CHAT_ID=your-dify-application-id

# Gamma API - PPT 簡報生成服務
# ============================================
# 取得 API Key: https://developers.gamma.app
GAMMA_API_KEY=sk-gamma-your-api-key

# ============================================
# LiteLLM API 配置（用於 Guardrails）
# ============================================
# LiteLLM Proxy 服務 URL
LITELLM_API_URL=https://your-litellm-host:4001
# LiteLLM API 金鑰（Master Key 或具有 Guardrails 權限的 Key）
LITELLM_API_KEY=sk-your-litellm-api-key

