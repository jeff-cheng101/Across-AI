# AI 分析配置
LLM_PROVIDER=Gemini
# LLM_SERVICE_URL=http://localhost:11434/v1
LLM_SERVICE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# ELK MCP 連接配置
# 使用 mcp-proxy 橋接 HTTP MCP Server（推薦）
ELK_MCP_SERVER_URL=http://127.0.0.1:8080
ELK_MCP_PROTOCOL=proxy

# stdio MCP Server（備用）
# ELK_MCP_PROTOCOL=stdio
# ELK_MCP_COMMAND=docker
# ELK_MCP_ARGS=run,--rm,--network,host,docker.elastic.co/mcp/elasticsearch,stdio
# 若未設定，系統會自動搜尋 macOS/Linux/Windows 常見路徑
# MCP_PROXY_PATH=/usr/local/bin/mcp-proxy


# 連接配置
ELK_MCP_TIMEOUT=600000  # 10分鐘，適應月度比較查詢需求
ELK_MCP_RETRY=3

# Elasticsearch 配置（使用 API Key 認證，無需用戶名/密碼）
ELK_HOST=https://127.0.0.1:9200
ELK_INDEX=adasone-cf-*
ELK_API_KEY=XzJlcm1wb0JQWGtnSXBHR0tEMFg6MERFYWFNTUFTTmxXOEhpdUg2aGwtUQ==
ELK_CLOUDFLARE_INDEX=adasone-cf-*
# 每次查詢的最大回傳筆數，請務必由 .env 控制以避免硬編碼
ELK_MAX_RESULTS=1000 # 不能超過 10000，Elasticsearch 單次查詢限制
# elasticsearch mcp server batch query size for queryElasticsearchBatched function
ELK_BATCH_SIZE=1        # 每批查詢的記錄數
ELK_MAX_BATCHES=1000     # 最多查詢的批次數（防止無限查詢）


# 查詢配置
ELK_TIME_RANGE=1h
ELK_MAX_TIME_RANGE=24h
ELK_ATTACK_THRESHOLD=20
ELK_TIME_WINDOW=10

# 服務配置
PORT=8081
NODE_ENV=development 

# CORS 配置
# 允許的前端 origin（支援多個，用逗號分隔）
# 注意：前端使用靜態匯出時，不能使用 Next.js rewrites，必須直接呼叫後端 API
# 因此需要明確配置允許的 origin，並支援 credentials（withCredentials: true）
CORS_ORIGINS=https://twister5poc.phison.com:3000,http://localhost:3000

# Dify Workflow API 配置
DIFY_SERVICE_URL=https://path/to/dify
DIFY_WORKFLOW_API_KEY_IP_BLOCK_QUICK=app-<real-ip-block-quick-workflow-app-id>
DIFY_WORKFLOW_API_KEY_IP_UNBLOCK_QUICK=app-<real-ip-unblock-quick-workflow-app-id>
DIFY_WORKFLOW_API_KEY_CLOUDFLARE_ATTACK_ANALYSIS=app-<real-cloudflare-attack-analysis-workflow-app-id>

# LiteLLM API 配置（用於 AI Gateway 儀表板）
# LiteLLM Proxy Server URL，例如：http://localhost:4000
LITELLM_API_URL=http://localhost:4000
# LiteLLM API Key（Master Key 或具有 spend 讀取權限的 Key）
LITELLM_API_KEY=sk-your-litellm-api-key
# 匯率設定（USD 轉 TWD，預設：32）
EXCHANGE_RATE=32
# AI Gateway 預算上限（TWD），未設定則使用訂閱費 × 1.2
# GATEWAY_BUDGET_LIMIT=100000